{
  "name": "@svitlo-power/shared-typescript",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint --config eslint.config.js src test",
    "lint:fix": "eslint --config eslint.config.js src test --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" eslint.config.js",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" eslint.config.js",
    "test": "npm run lint && npm run format:check && npm run build && node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.72.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
