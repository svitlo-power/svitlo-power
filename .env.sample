# App
OUTPUT_PORT=5005
ADMIN_OUTPUT_PORT=5006
DISABLE_PUBLIC_FRONTEND=false
# Public app-v2 browser configuration. Only set Firebase values to enable web push.
VITE_API_URL=/api/
VITE_APP_ACCESS_TOKEN=
VITE_PRIVACY_POLICY_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
DEBUG=True
DEBUG_HOST=0.0.0.0
ADMIN_USER=
ADMIN_PASSWORD=
JWT_SECRET_KEY=
# Used to encrypt Deye connection credentials at rest; must stay stable between restarts
SECRET_KEY=
INTERNAL_API_TOKEN=
INTERNAL_API_TIMEOUT_SECONDS=10
INTERNAL_API_URL=http://svitlo-power-back-end:5005/internal/v1/app
API_DOCS_ENABLED=false
APP_LOG_LEVEL=info
APP_LOG_PRETTY=false
APP_RATE_LIMIT_WINDOW_MS=60000
APP_RATE_LIMIT_MAX=120
APP_RATE_LIMIT_BLOCK_MS=60000
TRUST_PROXY_HOPS=1
# Backend fallback when VITE_APP_ACCESS_TOKEN is unset.
APP_ACCESS_TOKEN=
REDIS_URI=redis://svitlo-power-rds:6379/0
APP_BACKEND_SNAPSHOT_REFRESH_URL=http://svitlo-power-back-end:5005/internal/v1/snapshots/refresh
SSE_PING_INTERVAL=30
SSE_SCALE=3

# Redis dashboard rollout
# The UI event mode requires snapshot publishing and legacy Deye polling.
FEATURE_DASHBOARD_SNAPSHOT_PUBLISH=false
FEATURE_DASHBOARD_UPDATED_EVENT=false
FEATURE_DEYE_POLLING_PROCESSING=false
FEATURE_APP_BACKEND_DASHBOARD_SNAPSHOT_READS=false
APP_BACKEND_REDIS_DASHBOARD_STALE_THRESHOLD_SECONDS=300

# Registry (for deploy-registry.sh and docker-compose.yml)
REGISTRY_URL=your-registry.com
REGISTRY_USERNAME=your-username
REGISTRY_PASSWORD=your-token
PUBLIC_FRONTEND_TAG=latest
ADMIN_FRONTEND_TAG=latest

# Mongo
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=supersecretpassword
MONGO_URI=mongodb://root:supersecretpassword@svitlo-power-mongo:27017
MONGO_DB=svitlo-power

# Deye
DEYE_BASE_URL=https://eu1-developer.deyecloud.com/v1.0
DEYE_APP_ID=
DEYE_APP_SECRET=
DEYE_EMAIL=
DEYE_PASSWORD=
DEYE_SYNC_STATIONS_ON_POLL=True/False/Yes/No/1/0

# Telegram
TG_HOOK_BASE_URL=

# Push notifications (Firebase service account JSON or path to it)
FIREBASE_CREDENTIALS=

# Bot
BOT_TIMEZONE=Europe/Kyiv

# Database
STATISTIC_KEEP_DAYS=3