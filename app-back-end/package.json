{
  "name": "svitlo-power-app-back-end",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12 || ^24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint --config eslint.config.js src test",
    "lint:fix": "eslint --config eslint.config.js src test --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" eslint.config.js",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" eslint.config.js",
    "start": "node dist/app-back-end/src/main.js",
    "start:dev": "tsx watch --tsconfig tsconfig.json src/main.ts",
    "test": "tsc -p tsconfig.json && node --test dist/app-back-end/test/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "12.4.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/throttler": "6.7.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "@prometheus-io/client": "0.16.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "redis": "6.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.4.0",
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "supertest": "7.3.2",
    "typescript-eslint": "8.72.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "minimatch": "11.0.5",
    "multer": "2.5.0"
  }
}
