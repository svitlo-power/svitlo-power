upstream sse_upstream {
    server svitlo-power-sse-back-end:5005;
    server svitlo-power-sse-back-end:5005;
    server svitlo-power-sse-back-end:5005;

    keepalive 64;
}

server {
  listen       80;
  server_name  localhost;
  root /var/www/front-end;

  location /api/events {
    proxy_pass http://sse_upstream;

    proxy_http_version 1.1;
    proxy_set_header Connection '';
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;

    gzip off;
  }

  location /api {
    proxy_pass http://svitlo-power-back-end:5005;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /version {
    add_header Content-Type text/plain;
    try_files /VERSION =404;
  }

  location /metrics {
    add_header Content-Type text/plain;
    # Read version from VERSION file
    set $version "";
    if (-f /var/www/front-end/VERSION) {
        set $version "";
        # Use nginx's ability to read file content
    }
    # Use a simple approach - embed version at build time via envsubst
    return 200 'front_end_version_info{service="front-end",version="${VERSION}"} 1\n';
  }

  location / {
    try_files $uri /index.html;
  }

  error_page 404 /index.html;
  location = /index.html {
    allow all;
  }
}