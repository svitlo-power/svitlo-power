{
  "name": "svitlo-power-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "i18n:sync": "node -e \"require('fs-extra').copySync('../shared/i18n', 'src/i18n', { overwrite: true })\"",
    "i18n:watch": "chokidar \"../shared/i18n/**/*\" -c \"npm run i18n:sync\"",
    "dev": "concurrently \"npm run i18n:watch\" \"vite\"",
    "build": "npm run i18n:sync && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "^6.5.2",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@hookform/resolvers": "^5.7.1",
    "@mantine/charts": "^9.5.1",
    "@mantine/colors-generator": "^9.5.1",
    "@mantine/core": "^9.5.1",
    "@mantine/dates": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/modals": "^9.5.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-table": "^8.21.3",
    "@uiw/codemirror-extensions-langs": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@valibot/i18n": "^1.2.0",
    "axios": "^1.19.0",
    "codemirror": "^6.0.2",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.8",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.2.8",
    "react-ga4": "^3.0.1",
    "react-hook-form": "^7.84.0",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "react-snowfall": "^2.4.0",
    "recharts": "^3.10.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "chokidar": "^5.0.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fs-extra": "^11.4.0",
    "globals": "^17.9.0",
    "postcss": "^8.5.25",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.2.0"
  }
